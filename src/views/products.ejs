<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
<div class="products-container">
  <div class="navigation-menu">
    <ul class="nav justify-content-center">
      <li class="nav-item"><a class="nav-link active" href="/admin/">Home</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/product/all">Menu</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/user/all">Users</a></li>
      <li class="nav-item" onclick="return confirm('Do you want to logout?')">
        <a class="nav-link" href="/admin/logout">Logout</a>
      </li>
    </ul>
  </div>

  <div class="board">
    <div class="search-frame">
      <input type="text" id="search-input" placeholder="Search by product name..." />
      <button id="search-btn">Search</button>
      <button id="reset-btn">Reset</button>
    </div>

    <div class="products-table">
      <span class="new-product-txt">SkinBloom Products</span>
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Type</th>
            <th>Size</th>
            <th>Volume</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="product-table-body">
          <% products.forEach(function(product, index){ %>
            <tr>
              <td><%= index + 1 %></td>
              <td class="product-name"><%= product.productName %></td>
              <td><%= product.productCollection %></td>
              <td><%= product.productSize %></td>
              <td><%= product.productVolume %></td>
              <td><%= product.productPrice %></td>
              <td><%= product.productLeftCount %></td>
              <td>
                <select class="product-status-select" id="status-<%= product._id %>">
                  <option value="PAUSE" <%= product.productStatus === 'PAUSE' ? 'selected':'' %>>PAUSE</option>
                  <option value="ACTIVE" <%= product.productStatus === 'ACTIVE' ? 'selected':'' %>>ACTIVE</option>
                  <option value="DELETE" <%= product.productStatus === 'DELETE' ? 'selected':'' %>>DELETE</option>
                </select>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="new-product-btn-frame">
        <button class="btn btn-primary" id="toggle-form-btn">New Product</button>
      </div>
    </div>

    <form action="/admin/product/create" method="POST" enctype="multipart/form-data" class="product-form">
      <span class="new-product-txt">NEW PRODUCT DETAIL</span>

      <div class="input-group">
        <label>Name</label>
        <input type="text" name="productName" class="input-field" required />
      </div>

      <div class="input-group">
        <label>Price</label>
        <input type="number" name="productPrice" class="input-field" required />
      </div>

      <div class="input-group">
        <label>Stock</label>
        <input type="number" name="productLeftCount" class="input-field" required />
      </div>

      <div class="input-group">
        <label>Type</label>
        <select name="productCollection" class="input-field">
          <option value="PERFUME" selected>Perfume</option>
          <option value="SKINCARE">Skincare</option>
          <option value="MAKEUP">Makeup</option>
          <option value="HAIRCARE">Haircare</option>
          <option value="BODYCARE">Bodycare</option>
          <option value="ACCESSORY">Accessory</option>
          <option value="OTHER">Other</option>
        </select>
      </div>

      <div class="input-group">
        <label>Size</label>
        <select name="productSize" class="input-field">
          <option value="SMALL">Small</option>
          <option value="NORMAL" selected>Normal</option>
          <option value="LARGE">Large</option>
          <option value="SET">Set</option>
        </select>
      </div>

      <div class="input-group">
        <label>Volume (ml)</label>
        <select name="productVolume" class="input-field">
          <option value="10">10</option>
          <option value="30" selected>30</option>
          <option value="50">50</option>
          <option value="100">100</option>
          <option value="150">150</option>
          <option value="200">200</option>
        </select>
      </div>

      <div class="input-group">
        <label>Description</label>
        <textarea name="productDesc" class="input-field" required></textarea>
      </div>

      <div class="img-frame">
        <label>Product Images</label>
        <div class="media-frame">
          <div class="upload-img-box">
            <img src="/img/upload.svg" id="image-section-1"/>
            <input type="file" name="productImages" class="image-1" onchange="previewFileHandler(this,1)" required/>
          </div>
          <div class="upload-img-box">
            <img src="/img/upload.svg" id="image-section-2"/>
            <input type="file" name="productImages" class="image-2" onchange="previewFileHandler(this,2)" />
          </div>
          <div class="upload-img-box">
            <img src="/img/upload.svg" id="image-section-3"/>
            <input type="file" name="productImages" class="image-3" onchange="previewFileHandler(this,3)" />
          </div>
          <div class="upload-img-box">
            <img src="/img/upload.svg" id="image-section-4"/>
            <input type="file" name="productImages" class="image-4" onchange="previewFileHandler(this,4)" />
          </div>
          <div class="upload-img-box">
            <img src="/img/upload.svg" id="image-section-5"/>
            <input type="file" name="productImages" class="image-5" onchange="previewFileHandler(this,5)" />
          </div>
        </div>
      </div>

      <div class="form-buttons">
        <button type="button" id="cancel-btn" class="btn btn-danger">Cancel</button>
        <button type="submit" id="create-btn" class="btn btn-primary">
          <span class="btn-text">Create</span>
          <span class="btn-spinner">⏳</span>
        </button>
      </div>
    </form>

  </div>
</div>

<script src="/js/products.js"></script>
</body>
<%- include('includes/footer') %>







