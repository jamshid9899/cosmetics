<%- include('includes/header') %>


<link rel="stylesheet" href="/css/signup.css" />

<body>
  <div class="signup-container">

    <!-- Header -->
    <div class="signup-header">
      <div class="back-home"><a href="/admin">← Go back Home</a></div>
      <div class="login-link">Already signed up? <a href="/admin/login">Login</a></div>
    </div>

    <!-- Signup Blob Card -->
    <div class="signup-card">
      <form onsubmit="return validateSignupForm()" 
            action="/admin/signup" 
            method="POST" 
            enctype="multipart/form-data">

        <h2 class="signup-title">SkinBloom</h2>

        <div class="input-group">
          <input type="text" name="memberNick" class="member-nick" required placeholder=" "/>
          <label>Brand Name *</label>
        </div>

        <div class="input-group">
          <input type="text" name="memberPhone" class="member-phone" required placeholder=" "/>
          <label>Phone *</label>
        </div>

        <div class="input-group">
          <input type="password" name="memberPassword" class="member-password" required placeholder=" "/>
          <label>Password *</label>
        </div>

        <div class="input-group">
          <input type="password" name="confirmPassword" class="confirm-password" required placeholder=" "/>
          <label>Repeat Password *</label>
        </div>

        <div class="media-group">
          <div class="image-preview">
            <img class="upload-img-frame" src="/img/default1.jpeg" />
          </div>
          <div class="file-upload">
            <label for="input-file" class="file-input-label">Upload Image</label>
            <input type="file" id="input-file" class="upload-hidden member-image" name="memberImage" />
            <p class="file-desc">Upload your brand image (.jpg, .jpeg, .png)</p>
          </div>
        </div>

        <input name="memberType" value="COSMETICS" hidden />

        <button type="submit" class="signup-btn">Signup</button>
      </form>
    </div>
  </div>

  <script src="/js/signup.js"></script>
</body>


<%- include('includes/footer') %>